# 在线 Spring API 评测总开关；默认 false，防止误调用模型。
RAG_EVAL_ONLINE_ENABLED=false
RAG_EVAL_BASE_URL=http://localhost:8080
RAG_EVAL_JWT=replace-with-eval-user-jwt
RAG_EVAL_TARGET_TYPE=notebook
RAG_EVAL_TARGET_ID=replace-with-public-fixture-notebook-id
RAG_EVAL_OTHER_USER_JWT=replace-with-second-eval-user-jwt
RAG_EVAL_TOP_K=5

# DeepEval Judge 的第二道开关。只有两个开关都为 true 才可能产生费用。
RAG_EVAL_DEEPEVAL_ENABLED=false
RAG_EVAL_JUDGE_MODEL=replace-with-judge-model-name
RAG_EVAL_JUDGE_API_KEY=replace-with-judge-api-key
# OpenAI 兼容服务可填写 base URL；使用官方 OpenAI 时留空。
RAG_EVAL_JUDGE_BASE_URL=
RAG_EVAL_JUDGE_THRESHOLD=0.7
