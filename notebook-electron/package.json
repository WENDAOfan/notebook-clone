{
  "name": "notebook-electron",
  "version": "1.0.0",
  "description": "NotebookLM Clone - Local Electron & SQLite3 Desktop Application",
  "main": "main.js",
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "eval:online": "node eval/run.js --online",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.notebook.clone",
    "productName": "NotebookClone",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!config.json",
      "!test/**/*",
      "!eval/**/*",
      "!docs/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@llamaindex/liteparse/**/*"
    ]
  },
  "dependencies": {
    "@llamaindex/liteparse": "^2.5.1",
    "@openai/agents": "0.13.5",
    "dompurify": "3.4.12",
    "js-tiktoken": "^1.0.10",
    "marked": "12.0.0",
    "mammoth": "^1.7.0",
    "openai": "6.46.0",
    "sqlite3": "6.0.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.12"
  }
}
